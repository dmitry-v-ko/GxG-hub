#!/usr/bin/env bash
# The gate of `{{ name }}`: lockfile, lint, types, tests, the GxG conformance suite. Run from anywhere.
set -euo pipefail
cd "$(dirname "$0")/.."
uv lock --check
uv sync --locked
uv run ruff check .
uv run ruff format --check .
uv run mypy src tests
uv run pytest
uv run check-connectors --connector .
echo "check-all: OK"
