{%- set P = name | upper -%}
# Configuration of `{{ name }}` (gxg_connector_kit.mcp.Settings). Public keys and paths only: no secret here.
GXG_PROFILE=production
{{ P }}_BUNDLE_DIR=/bundle
{{ P }}_BUNDLE_KEYS=<kid>=ed25519:<base64url public key of the bundle signer>
{{ P }}_STATE_FILE=/var/lib/{{ name }}/bundle-state.json
{{ P }}_IDENTITY_KEYS=<kid>=ed25519:<base64url public key of the ContextForge identity adapter>
{%- if with_effects %}
{{ P }}_APPROVAL_URL=https://approval-api.internal
{{ P }}_APPROVAL_AUDIENCE=approval-api
{{ P }}_SVC_KEY_FILE=/run/secrets/{{ name }}-svc-key   # mounted secret: Ed25519 seed, base64url
{%- endif %}
# {{ P }}_PROVIDER_TOKEN comes from the secret store as an environment variable or file, never from this file.
