{%- set pkg = name ~ "_connector" -%}
# Production image of the GxG connector `{{ name }}` (made from templates/python-fastmcp).
{%- if kit_source == "path" %}
# Build from the repository root: docker build -f connectors/{{ name }}/Dockerfile .
# The kit comes in by path source (pyproject.toml); versions from uv.lock.
{%- else %}
# Build from this directory: docker build . — the kit comes from GxG-hub at the commit pinned in pyproject.toml.
# A private GxG-hub needs read access for the build: --secret id=git-credentials (a git credential store line).
{%- endif %}
FROM ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c AS uv

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 UV_FROZEN=1
{%- if kit_source == "path" %}
WORKDIR /app
COPY packages/gxg-connector-kit packages/gxg-connector-kit
COPY schemas schemas
COPY connectors/{{ name }} connectors/{{ name }}
WORKDIR /app/connectors/{{ name }}
{%- else %}
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
{%- endif %}
# A dev stand builds with KEEP_TEST_CONTROLS=1; the default production image drops them and the conformance harness.
ARG KEEP_TEST_CONTROLS=0
# Optional secret `ca-bundle`: a TLS-intercepting proxy's CA for the download only, never stored in a layer.
RUN --mount=type=secret,id=ca-bundle,required=false {% if kit_source == "git" %}--mount=type=secret,id=git-credentials,required=false {% endif %}\
    if [ -f /run/secrets/ca-bundle ]; then export SSL_CERT_FILE=/run/secrets/ca-bundle; fi \
{%- if kit_source == "git" %}
    && if [ -f /run/secrets/git-credentials ]; then \
         git config --global credential.helper "store --file=/run/secrets/git-credentials"; fi \
{%- endif %}
    && uv sync --no-dev \
    && rm -f src/{{ pkg }}/conformance.py \
    && if [ "$KEEP_TEST_CONTROLS" != 1 ]; then rm -f src/{{ pkg }}/testctl.py; fi

FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
COPY --from=build /app /app
RUN useradd --system --uid 10001 {{ name }} && mkdir -p /var/lib/{{ name }} && chown {{ name }} /var/lib/{{ name }}
USER {{ name }}
{%- if kit_source == "path" %}
ENV PATH=/app/connectors/{{ name }}/.venv/bin:$PATH PYTHONUNBUFFERED=1
{%- else %}
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
{%- endif %}
EXPOSE 8080{% if with_effects %} 8081{% endif %}
VOLUME ["/var/lib/{{ name }}"]
CMD ["python", "-m", "{{ pkg }}"]
