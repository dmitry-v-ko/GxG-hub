{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "items.search input",
  "description": "Search the items of the collections the caller may read. Text match on title and text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query"
  ],
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "collection_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "description": "Only these collections; one without a read grant is not found, like a missing one (GR-17)"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 20
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1024
    }
  }
}
