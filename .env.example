# LOCAL DEVELOPMENT ONLY. Do not copy by hand: `uv run python stand/init.py` writes .env (git-ignored)
# with random values for every variable below. Never commit .env.
# The ContextForge image is pinned by digest in compose.yaml (SEC-22, ADR-0001); advisories: ADR-0001, ADR-0002.
POSTGRES_PASSWORD=__GENERATED__
JWT_SECRET_KEY=__GENERATED__
AUTH_ENCRYPTION_SECRET=__GENERATED__
PLATFORM_ADMIN_EMAIL=admin@operator.gxg.example.com
PLATFORM_ADMIN_PASSWORD=__GENERATED__
DEFAULT_USER_PASSWORD=__GENERATED__
BASIC_AUTH_PASSWORD=__GENERATED__
DEMO_PROVIDER_TOKEN=__GENERATED__
DEMO_IDENTITY_KEYS=stand-adapter-1=ed25519:__PUBLIC_KEY__
DEMO_BUNDLE_KEYS=stand-bundle-1=ed25519:__PUBLIC_KEY__
