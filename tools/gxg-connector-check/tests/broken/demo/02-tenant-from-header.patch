+class TenantHeader:
+    """BROKEN: `X-Tenant-Id` from the caller overrides the verified tenant."""
+
+    def __init__(self, real: Any) -> None:
+        self.real = real
+
+    def verify(self, headers: Any, **kw: Any) -> Any:
