{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gxg.example/hub/v1/preview.schema.json",
  "title": "GxG Effect Preview v1",
  "description": "Human-facing rendering of an intent, built by the connector from canonical args. UI renders every string as plain text (EFF-30..EFF-33).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "target",
    "fields"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "From the connector manifest, not from args"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "rid"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "rid": {
          "type": "string",
          "maxLength": 512
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "value": {
            "type": "string",
            "maxLength": 20000
          },
          "kind": {
            "enum": [
              "text",
              "multiline",
              "identifier",
              "amount",
              "datetime"
            ]
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "before",
          "after"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 80
          },
          "before": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          },
          "after": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 5000
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "size_bytes",
          "mime"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mime": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
