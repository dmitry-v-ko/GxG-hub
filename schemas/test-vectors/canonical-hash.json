    {
      "name": "float_forbidden",
      "input": {
        "args": {
          "amount": 19.99
        }
      },
      "expected_error": "invalid_input"
    },
    {
      "name": "int_out_of_safe_range",
      "input": {
        "args": {
          "n": 9007199254740993
        }
      },
      "expected_error": "invalid_input"
    },
    {
      "name": "float_one_point_zero",
      "input_json": "{\"args\":{\"a\":1.0}}",
      "expected_error": "invalid_input"
    }
  ],
