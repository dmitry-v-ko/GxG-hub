{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gxg.example/hub/v1/execute-request.schema.json",
  "title": "GxG Execute Request v1",
  "description": "Body of POST /internal/v1/execute/{execute_tool} from Executor to connector",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "execution_id",
    "execution_token",
    "args"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_token": {
      "type": "string",
      "maxLength": 4096
    },
    "args": {
      "type": "object",
      "description": "Canonical args; connector recomputes hash and compares with ahs"
    }
  }
}
