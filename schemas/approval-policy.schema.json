{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gxg.example/hub/v1/approval-policy.schema.json",
  "title": "GxG Approval Policy v1",
  "description": "Per-tenant approval policy file. See docs/specs/approval-policy-v1.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "schema_version",
    "rules"
  ],
  "properties": {
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "schema_version": {
      "const": 1
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approval_ttl": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|h|d)$"
        },
        "execution_window": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|h|d)$"
        }
      }
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "propose_per_requester_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pending_per_requester_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pending_per_tenant_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "description": {
            "type": "string",
            "maxLength": 300
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "tools": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9_.]+$"
                }
              },
              "effect_classes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "write_reversible",
                    "external_effect",
                    "high_risk"
                  ]
                }
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[a-z][a-z0-9_]*:[a-z0-9][a-z0-9_-]*/[a-z][a-z0-9_]*/([^/*\\s]+|\\*)$"
                }
              },
              "requesters": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(agent:\\S+|group:[a-z0-9][a-z0-9_-]*)$"
                }
              }
            }
          },
          "decision": {
            "enum": [
              "deny",
              "require_approval",
              "auto_approve"
            ]
          },
          "approvals": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "step_up": {
            "type": "boolean"
          },
          "approvers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(oidc:\\S+|group:[a-z0-9][a-z0-9_-]*)$"
            }
          },
          "approval_ttl": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(m|h|d)$"
          },
          "execution_window": {
            "type": "string",
            "pattern": "^[1-9][0-9]*(m|h|d)$"
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_per_hour": {
                "type": "integer",
                "minimum": 1
              },
              "max_per_day": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "auto_approve"
                }
              }
            },
            "then": {
              "required": [
                "limits"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "approvals"
                    ]
                  },
                  {
                    "required": [
                      "step_up"
                    ]
                  },
                  {
                    "required": [
                      "approvers"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "decision": {
                  "const": "deny"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "approvals"
                    ]
                  },
                  {
                    "required": [
                      "limits"
                    ]
                  },
                  {
                    "required": [
                      "approvers"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
