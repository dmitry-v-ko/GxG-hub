{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gxg.example/hub/v1/error.schema.json",
  "title": "GxG Error v1",
  "description": "structuredContent of an MCP tool error and body of internal API errors (MCC-05)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "code": {
      "enum": [
        "invalid_input",
        "unsupported_version",
        "unauthenticated",
        "permission_denied",
        "resource_forbidden",
        "not_found",
        "conflict",
        "effect_disabled",
        "rate_limited",
        "temporarily_unavailable",
        "timeout_before_start",
        "outcome_unknown",
        "internal_error"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 500,
      "description": "Safe for the caller; no secrets, no foreign resource details"
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_after_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "details": {
      "type": "object",
      "maxProperties": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "outcome_unknown"
          }
        }
      },
      "then": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    }
  ]
}
