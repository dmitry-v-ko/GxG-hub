{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gxg.example/hub/v1/grants-bundle.schema.json",
  "title": "GxG signed policy bundle v1",
  "description": "grants-bundle.json (GR-11a). Bytes are JCS; signature in grants-bundle.json.sig.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_version",
    "built_at",
    "tenants",
    "platform"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "bundle_version": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "tenants": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grants",
          "approval_policy"
        ],
        "properties": {
          "grants": {
            "$ref": "resource-grants.schema.json"
          },
          "approval_policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "approval-policy.schema.json"
              }
            ]
          }
        }
      }
    },
    "platform": {
      "$ref": "platform-registry.schema.json"
    }
  }
}
